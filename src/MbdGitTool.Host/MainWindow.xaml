<Window x:Class="MbdGitTool.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MBD Git Tool v1.0" Height="900" Width="1440" Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" />
        <Border x:Name="RuntimeMissing" Visibility="Collapsed" Background="#14161A">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="界面初始化失败" Foreground="#F87171" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock x:Name="RuntimeMissingDetail" Foreground="#E6E8EB" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
