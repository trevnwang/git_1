          <mxGeometry height="93" width="140" x="170" y="186" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-88" parent="hv4APbYuL6OXi96OPKf1-61" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="SIL仓库文件列表，树状结构，可以分层打开，双击可用默认程序打开文件或者文件夹" vertex="1">
          <mxGeometry height="93" width="140" x="320" y="186" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-90" parent="hv4APbYuL6OXi96OPKf1-61" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="PULL" vertex="1">
          <mxGeometry height="16" width="55" x="170" y="292" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-91" parent="hv4APbYuL6OXi96OPKf1-61" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="FETCH" vertex="1">
          <mxGeometry height="16" width="55" x="232.5" y="292" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-92" parent="hv4APbYuL6OXi96OPKf1-61" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="CHKOUT" vertex="1">
          <mxGeometry height="16" width="55" x="301" y="293" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-93" parent="hv4APbYuL6OXi96OPKf1-61" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="状态栏，显示最近一次操作的状态" vertex="1">
          <mxGeometry height="22" width="490" x="20" y="322" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-94" parent="hv4APbYuL6OXi96OPKf1-61" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="COMMIT" vertex="1">
          <mxGeometry height="16" width="55" x="369" y="292" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-95" parent="hv4APbYuL6OXi96OPKf1-61" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="PUSH" vertex="1">
          <mxGeometry height="16" width="55" x="440" y="293" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-96" parent="hv4APbYuL6OXi96OPKf1-61" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="菜单栏" vertex="1">
          <mxGeometry height="16" width="490" x="20" y="25" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-101" parent="hv4APbYuL6OXi96OPKf1-61" style="rounded=0;whiteSpace=wrap;html=1;" value="选中子仓库的基本信息和构建是否够成功" vertex="1">
          <mxGeometry height="181" width="30" x="470" y="91" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-99" parent="hv4APbYuL6OXi96OPKf1-52" style="whiteSpace=wrap;html=1;rounded=0;align=left;" value="1. 菜单栏用来登录认证，配置参数，配置完成后保存为本地json&lt;div&gt;2. 标题栏显示程序Title，版本，管理的总组件数和仓库数&lt;/div&gt;&lt;div&gt;3. 组件卡片列表显示所有的组件，以及他们子仓库的信息：&lt;/div&gt;&lt;div&gt;3.1 卡片以颜色显示子仓库信息Design Impl MIL SIL等，灰色为MISS，黄色为冲突，红色为超前，绿色为同步，其他颜色为滞后&lt;/div&gt;&lt;div&gt;3.2 卡片本身的颜色由聚合后的组件状态决定，颜色同上&lt;/div&gt;&lt;div&gt;3.3 如组件的子仓库有未提交的change，则子仓库的组件名和对应&lt;span style=&quot;background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;子仓库信息Design Impl MIL SIL要在右侧加*号示意，比如&lt;/span&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;CF325F*和Design*&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;3.4 卡片本身需要显示仓库的当前分支，如果四个子仓库当前分支不一致，显示Impl仓库的当前本地分支&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;3.5 卡片本身需要提供SYNC按钮，点击以后会操作所有子仓库，使用远程分支覆盖本地，如果本地有变更或者超前的分支会提示用户是否强制使用远程最新版覆盖本地。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;3.6 卡片本身需要提供CREATE按钮，点击以后要求用户输入需要创建的分支名称，一次性给当前所有子仓库创建同样的分支，创建之前需要先dryrun，看看是不是重名，或者是不是当前最新版。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;4 文件树区域的最上方显示仓库名称，并按照3.3规则加*号&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;5 文件树右侧有选中仓库的基本信息，所有提交历史。滞后超前等，还有远程的build结果是否失败。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;6. 下方按钮PULL FETCH CHKOUT COMMIT PUSH都是单个操作，不同时对四个子仓库发起，只对当前选中的仓库执行&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;7. 最下方状态栏显示软件运行是否正常，以及后台几个进程有没有问题等。&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(#000000, var(--ge-light-color, #ffffff));&quot;&gt;8. 其他功能暂时不表&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="396" width="430" x="760" y="40" as="geometry" />
        </mxCell>
        <mxCell id="hv4APbYuL6OXi96OPKf1-89" edge="1" parent="1" style="endArrow=none;dashed=1;html=1;rounded=0;defaultLabelBackgroundColor=page;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="400" y="-500" as="sourcePoint" />
            <mxPoint x="740" y="-500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
